# The release version, read by scripts/build.sh, scripts/build-gui.sh and scripts/build-dmg.sh.
# STORAGE_MONITOR_VERSION / STORAGE_MONITOR_BUILD in the environment still override it for one build.
# The build number only increases: 1.0.6 (7), 2.0.0 (8), the 2.1.0 local test DMG (1), 2.1.0 (9), 2.2.0 (10), 2.4.0 dev (18), 2.4.1 (20).
STORAGE_MONITOR_RELEASE_VERSION=2.4.1
STORAGE_MONITOR_RELEASE_BUILD=20
